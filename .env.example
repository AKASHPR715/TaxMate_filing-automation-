# TaxMate Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================
# API Keys
# ============================================================

# Llama Cloud API (for PDF extraction)
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here

# Google Gemini API (for vision-based extraction)
# Get your key: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# OpenRouter API (for chat functionality)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Tavily API (for web search in tax advisor)
TAVILY_API_KEY=your_tavily_api_key_here

# ============================================================
# Database — MongoDB
# ============================================================

# Local development:
# MONGO_URI=mongodb://localhost:27017
# MongoDB Atlas (production — free M0 cluster):
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=taxmate_db

# ============================================================
# Vector Database — Qdrant
# ============================================================

# Local development: leave these blank (uses local ./qdrant_storage)
# Qdrant Cloud (production — free 1GB tier): https://cloud.qdrant.io
QDRANT_URL=https://<your-cluster-id>.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# ============================================================
# Embeddings — Ollama (optional)
# ============================================================

# Local development with Ollama: set this to your Ollama server
# OLLAMA_BASE_URL=http://localhost:11434
# Production: leave blank — app will use FastEmbed (no server needed)
# OLLAMA_BASE_URL=

# ============================================================
# CORS — Frontend Origins
# ============================================================

# Development defaults (localhost) — already set in code
# For production, add your Vercel/Netlify URL here (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-app.vercel.app

# ============================================================
# Application Settings
# ============================================================

ENVIRONMENT=production

# JWT Secret (generate a strong random string for production)
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_super_secret_jwt_key_here

# Default placeholder values (used in form generation)
DEFAULT_AADHAAR=123456789012
DEFAULT_MOBILE=9999999999
DEFAULT_EMAIL=test@example.com
