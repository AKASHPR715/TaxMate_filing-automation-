# TaxMate Environment Configuration

# ============================================================
# API Keys
# ============================================================

# Llama Cloud API (for PDF extraction - legacy)
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here

# Google Gemini API (for vision-based extraction - NEW!)
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# OpenRouter API (for chat functionality)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============================================================
# Database
# ============================================================

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/tax_filing

# ============================================================
# Application Settings
# ============================================================

# Environment (development/production)
ENVIRONMENT=development

# Default values (optional - for testing)
DEFAULT_AADHAAR=123456789012
DEFAULT_MOBILE=9999999999
DEFAULT_EMAIL=test@example.com
