# TaxMate Experiments - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Google Cloud (Vertex AI) - For Gemini Models
# ============================================
# Get your project ID: gcloud config get-value project
GOOGLE_CLOUD_PROJECT=your-project-id-here

# Region (us-central1 recommended for best model availability)
GOOGLE_CLOUD_LOCATION=us-central1

# ============================================
# OpenAI API (Optional - for comparison)
# ============================================
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ============================================
# OpenRouter API (Optional - for free models)
# ============================================
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ============================================
# Notes
# ============================================
# - For Google Cloud: You must run 'gcloud auth application-default login' first
# - For OpenAI: Required if using gpt-* models
# - For OpenRouter: Required if using models with :free suffix
